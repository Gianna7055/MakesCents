# ================================
# Root-level ignores for OS & editors
# ================================
# macOS
.DS_Store

# Windows
Thumbs.db

# VS Code
.vscode/
*.code-workspace

# Logs
*.log

# ================================
# Backend: ASP.NET Core / .NET
# ================================
# Build outputs
/Backend/bin/
/Backend/obj/

# User-specific files
/Backend/*.user
/Backend/*.suo
/Backend/*.userosscache
/Backend/*.sln.docstates

# Debug / symbols
/Backend/*.pdb

# Local DB files (optional)
/Backend/*.db

# Environment settings (optional)
/Backend/appsettings.*.json

# ================================
# Frontend: Expo React Native / Node
# ================================
# Node modules
/Frontend/node_modules/

# Expo caches and build artifacts
/Frontend/.expo/
/Frontend/.expo-shared/
/Frontend/.expo/web/cache/
/Frontend/build/

# TypeScript cache
/Frontend/*.tsbuildinfo

# iOS / Android build folders
/Frontend/android/
/Frontend/ios/
/Frontend/.gradle/
/Frontend/*.apk
/Frontend/*.aab
/Frontend/*.app
/Frontend/*.keystore

# Logs
/Frontend/npm-debug.log*
/Frontend/yarn-debug.log*
/Frontend/yarn-error.log*
/Frontend/pnpm-debug.log*

# ================================
# Documentation folder
# ================================
/Documentation/*.mwb.bak
